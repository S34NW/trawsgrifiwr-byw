{
  "name": "trawsgrifiwr-byw-mobile",
  "version": "1.0.0",
  "description": "Ap adnabod Lleferydd Cymraeg Byw / Real-time Welsh Speech Recognition Mobile App",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "eas-build-post-install": "bash ./download-model.sh",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/@react-native-ml-kit/translate-text/android/build.gradle';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');if(!c.includes('namespace')){fs.writeFileSync(p,c.replace('android {','android {\\\\n    namespace \\'com.rnmlkit.translatetext\\''));}}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-ml-kit/translate-text": "^0.5.0",
    "expo": "~58.0.21",
    "expo-clipboard": "^58.0.3",
    "expo-file-system": "^58.0.12",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-sharing": "^58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-vosk": "^2.1.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
